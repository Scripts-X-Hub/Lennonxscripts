copyButton.TextSize = 14;
copyButton.Font = Enum.Font.GothamBold;
copyButton.TextColor3 = Color3.fromRGB(235, 235, 240);
copyButton.ZIndex = 102;
copyButton.Parent = lockBox;
corner(copyButton, 15);
copyButton.MouseButton1Click:Connect(function()
	local FlatIdent_AC2F = 0;
	local copied;
	while true do
		if (FlatIdent_AC2F == 2) then
			if (copyButton and copyButton.Parent) then
				copyButton.Text = "Copy URL";
			end
			break;
		end
		if (FlatIdent_AC2F == 1) then
			if copied then
				copyButton.Text = "Copied!";
			else
				copyButton.Text = "Copy failed";
			end
			task.wait(1.5);
			FlatIdent_AC2F = 2;
		end
		if (FlatIdent_AC2F == 0) then
			copied = false;
			pcall(function()
				local FlatIdent_5962D = 0;
				while true do
					if (0 == FlatIdent_5962D) then
						setclipboard(GROUP_URL);
						copied = true;
						break;
					end
				end
			end);
			FlatIdent_AC2F = 1;
		end
	end
end);
local connectedButtons = {};
local function setupLockedButton(button)
	local FlatIdent_8435E = 0;
	while true do
		if (FlatIdent_8435E == 0) then
			if connectedButtons[button] then
				return;
			end
			connectedButtons[button] = true;
			FlatIdent_8435E = 1;
		end
		if (FlatIdent_8435E == 1) then
			button.Activated:Connect(function()
				local FlatIdent_206F8 = 0;
				while true do
					if (0 == FlatIdent_206F8) then
						if button:IsDescendantOf(lockOverlay) then
							return;
						end
						lockOverlay.Visible = true;
						break;
					end
				end
			end);
			break;
		end
	end
end
for _, obj in ipairs(main:GetDescendants()) do
	if (obj:IsA("GuiButton") and not obj:IsDescendantOf(lockOverlay)) then
		setupLockedButton(obj);
	end
end
main.DescendantAdded:Connect(function(obj)
	if (obj:IsA("GuiButton") and not obj:IsDescendantOf(lockOverlay)) then
		setupLockedButton(obj);
	end
end);
